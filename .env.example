# FETCH2 Inventory Service Configuration
# Copy this file to .env and customize

# REQUIRED: Secret key for JWT signing
# Generate a new one for production: openssl rand -hex 32
JWT_SECRET_KEY=local-dev-secret-key-change-this-in-production

# App Environment settings
APP_ENVIRONMENT=local

# RECOMMENDED for local development:
DATABASE_URL=postgresql://postgres:postgres@inventory-database:5432/inventory_service

# OPTIONAL: Request timing logs
# Requests taking this long or longer are logged as warnings (default 500)
# SLOW_REQUEST_THRESHOLD_MS=500
# Log the timing of every request, not just slow ones (high volume; for investigations)
# LOG_ALL_REQUEST_TIMES=false
